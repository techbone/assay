{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The real price of a tokenized stock.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --mode live tests/live",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "collect": "tsx src/collector/run.ts --interval 120",
    "collect:once": "tsx src/collector/run.ts --once",
    "health": "tsx scripts/health.ts",
    "analyze": "tsx scripts/analyze.ts",
    "api": "tsx src/api/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3"
  }
}